# BTCPay Server – Coolify environment variables
# Copy to .env for local generation, or set these in Coolify's Environment tab.

# Public hostname (Coolify can also set this via SERVICE_FQDN_BTCPAYSERVER)
BTCPAY_HOST=btcpay.example.com

# Must be http when Coolify Traefik terminates TLS
BTCPAY_PROTOCOL=http

# Blockchain network
NBITCOIN_NETWORK=mainnet

# Optional: override generated postgres password
# POSTGRES_PASSWORD=
